}

model MentorEvaluation {
  id       String @id @default(cuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  engagement    Int
  communication Int
  reviewDetail  Int
  learnerImpact Int
  score         Int
  classification MentorClassification
  administrativeAction String?
  reviewPeriod  String

  createdAt DateTime @default(now())

  @@map("mentor_evaluations")
}

enum MentorClassification {
  OUTSTANDING
  STRONG
  SATISFACTORY
  IMPROVEMENT_NEEDED
}

/// QMS §15 risk register, IDs formatted AL-Q-###.
model QualityIssue {
  id        String @id @default(cuid())
  issueRef  String @unique
  summary   String @db.Text
  severity  Severity
  detectedAt DateTime @default(now())
  actionTaken String? @db.Text
  ownerId   String?
  status    QualityStatus @default(OPEN)

  capaCases CapaCase[]

  @@map("quality_issues")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum QualityStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// QMS §14 — six-step CAPA workflow.
model CapaCase {
  id      String       @id @default(cuid())
  issueId String
  issue   QualityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  step            Int @default(1) // 1–6
