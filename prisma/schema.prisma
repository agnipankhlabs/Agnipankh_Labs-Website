}

model AuditRecord {
  id        String   @id @default(cuid())
  auditCycle String
  scope     String
  status    AuditStatus
  remediationDueDate DateTime?
  escalatedCapaId String?

  retentionClass     RetentionClass @default(YEARS_3)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

