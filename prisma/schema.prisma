}

enum HiringStage {
  SCREENING
  INITIAL_SCREENING
  TECHNICAL_ROUND
  FINAL_TALK
  OFFER
  HIRED
  REJECTED
}

/// PRD Partnerships, extended per Investor Deck §8–11.
model Partnership {
  id               String      @id @default(cuid())
  partnerType      PartnerType
  organizationName String
  contactPersonName String?
  designation      String?
  email            String
  phone            String?
  city             String?
  message          String?     @db.Text
  status           LeadStatus  @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partnerships")
}

// ============================================================================
// SUPPORT — Module 10 exists in the PRD but has NO backing entity there.
// Ops Manual defines the categories and the 24h/12h/6h response commitment;
// QMS §12 adds the four service categories and SLA breach tracking.
// ============================================================================

model SupportTicket {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation("TicketRequester", fields: [userId], references: [id])

  /// Unauthenticated visitors can raise tickets from /contact.
  requesterEmail String
  requesterName  String?

  subject  String
  body     String  @db.Text
  category TicketCategory
  channel  TicketChannel  @default(WEBSITE_FORM)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  /// Ops Manual SLA: General 24h, Technical 12h, Urgent 6h.
  responseSlaHours Int?
  slaDueAt         DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  slaBreached      Boolean   @default(false)
  firstContactResolution Boolean @default(false)

  retentionClass     RetentionClass @default(YEARS_2)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@map("support_tickets")
}

enum TicketCategory {
  GENERAL
  TECHNICAL
  URGENT
  CERTIFICATE
  ACADEMIC
}

enum TicketChannel {
  EMAIL
  WHATSAPP
  WEBSITE_FORM
  DASHBOARD
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

// ============================================================================
// QUALITY — QMS AL-QMS-001. None of this exists in the PRD's 16 entities.
// ============================================================================

model FeedbackSurvey {
  id       String @id @default(cuid())
  userId   String?
  user     User?  @relation(fields: [userId], references: [id])
  cohortId String?

  touchpoint SurveyTouchpoint
  score      Int // 1–10
  comments   String? @db.Text
  interventionTriggered Boolean @default(false)

  submittedAt DateTime @default(now())

  @@map("feedback_surveys")
}

enum SurveyTouchpoint {
  ONBOARDING
  MID_COHORT_SPRINT
  COMPLETION
