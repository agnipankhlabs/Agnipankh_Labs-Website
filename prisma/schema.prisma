  @@map("audit_records")
}

enum AuditStatus {
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
}

/// QMS: post-program placement and career impact, tracked 3–6 months out.
model PlacementOutcome {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId String?

  employerName String?
  jobTitle     String?
  placedAt     DateTime?
  salaryLpa    Decimal? @db.Decimal(10, 2)
  /// Publishing any of this as a success story requires explicit consent.
  consentToPublish Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("placement_outcomes")
}

// ============================================================================
// FINANCE — Finance & Governance Pack.
// Payment status MUST carry FAILED/CANCELLED/REFUNDED: the pack's own invoice
// template offers only Paid|Pending, which cannot represent a gateway failure.
// ============================================================================

model Payment {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  /// INR in paise. Currency is explicit because no source document ever spells
  /// out the ISO code — see the founder checklist.
  amountPaise Int
  currency    String @default("INR")

  status        PaymentStatus @default(PENDING)
  revenueStream RevenueStream
  mode          PaymentMode?

  /// Tokenised reference only. Cybersecurity Framework forbids storing raw card data.
  gatewayName        String?
  gatewayOrderId     String?
  gatewayPaymentId   String?
  gatewaySignature   String?

  refundedAmountPaise Int?
  refundedAt          DateTime?
  failureReason       String?

  invoice Invoice?

  retentionClass     RetentionClass @default(YEARS_7)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMode {
  UPI
  NET_BANKING
  CARD
  WALLET
  OTHER
}

enum RevenueStream {
  INTERNSHIP_PROGRAMS
  TRAINING_PROGRAMS
  CERTIFICATION_SERVICES
  ACADEMIC_PARTNERSHIPS
  CORPORATE_SPONSORSHIPS
  EVENTS_AND_WORKSHOPS
}

/// The Finance Pack mandates GST/TDS compliance but its own invoice template has
/// no GSTIN, GST rate, HSN/SAC or place-of-supply field. Those are added here.
model Invoice {
  id            String  @id @default(cuid())
  invoiceNumber String  @unique
  paymentId     String? @unique
  payment       Payment? @relation(fields: [paymentId], references: [id])

  billToName    String
  billToEmail   String?
  billToAddress String? @db.Text
  billToGstin   String?

  description      String  @db.Text
  subtotalPaise    Int
  gstRatePercent   Decimal? @db.Decimal(5, 2)
  cgstPaise        Int?
  sgstPaise        Int?
  igstPaise        Int?
  totalPaise       Int
  hsnSac           String?
  placeOfSupply    String?

  issuedAt      DateTime @default(now())
  authorizedBy  String?

  retentionClass     RetentionClass @default(YEARS_7)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

  @@map("invoices")
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique
  clientName      String
  scope           String   @db.Text
  totalPaise      Int
  validUntil      DateTime
  preparedBy      String?

  createdAt DateTime @default(now())

  @@map("quotations")
}

/// Finance Pack §6 approval matrix: <=Rs2,000 Team Lead; Rs2,001–10,000 Founder;
/// >Rs10,000 Founder + Co-Founder jointly. The joint tier is why a second
/// approver column exists.
model Expense {
  id           String  @id @default(cuid())
  category     ExpenseCategory
  amountPaise  Int
  description  String? @db.Text
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  vendorId     String?
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])

  ownerId          String?
  approverId       String?
  secondApproverId String?
  approvalTier     ApprovalTier
  approvedAt       DateTime?
  voucherUrl       String?

  retentionClass     RetentionClass @default(YEARS_7)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

  createdAt DateTime @default(now())

  @@map("expenses")
}

enum ExpenseCategory {
  TECHNOLOGY
  MARKETING_AND_GROWTH
  OPERATIONS
  HUMAN_RESOURCES
}

enum ApprovalTier {
  TEAM_LEAD
  FOUNDER
  FOUNDER_JOINT
}

/// Cybersecurity Framework requires a vendor register with SOC2/ISO 27001 status.
model Vendor {
  id       String  @id @default(cuid())
  name     String
  service  String?
  soc2     Boolean @default(false)
  iso27001 Boolean @default(false)
  uptimeSla String?
  lastReviewedAt DateTime?

  expenses Expense[]

  createdAt DateTime @default(now())

  @@map("vendors")
}

// ============================================================================
// SECURITY & COMPLIANCE — Cybersecurity Framework AL-SEC-001
// ============================================================================

model AuditLog {
  id       String @id @default(cuid())
  userId   String?
  user     User?  @relation(fields: [userId], references: [id])
  roleKey  String?

  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  /// UTC, always.
  occurredAt DateTime @default(now())

  retentionClass     RetentionClass @default(YEARS_1)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

  @@index([userId, occurredAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model SecurityIncident {
  id              String   @id @default(cuid())
  detectionSource String
  summary         String   @db.Text
  severity        Severity
  containmentActions String? @db.Text
  forensicFindings   String? @db.Text
  dataImpact         String? @db.Text
  rootCause          String? @db.Text
  patchReference     String?
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?

  @@map("security_incidents")
}

model BackupRecord {
  id       String @id @default(cuid())
  target   String
  cadence  String
  location String?
  geoRedundant Boolean @default(false)
  takenAt  DateTime @default(now())

  @@map("backup_records")
}

/// DPDP Act 2023 requires a lawful basis and a consent-withdrawal mechanism.
/// The Legal Pack contains neither, so consent is modelled explicitly.
model Consent {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Most consent is given BEFORE an account exists — a newsletter signup or a
  /// contact form. Without this, an anonymous consent record is unattributable
  /// and therefore worthless as evidence of lawful basis.
  subjectEmail String?

  purpose     ConsentPurpose
  granted     Boolean
  policyVersion String?
  ipAddress   String?
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([subjectEmail])
  @@map("consents")
}

enum ConsentPurpose {
  PRIVACY_POLICY
  MARKETING_EMAIL
  ANALYTICS_COOKIES
  TESTIMONIAL_PUBLICATION
  PLACEMENT_STORY
  CERTIFICATE_PUBLIC_VERIFICATION
}

// ============================================================================
// PLATFORM
// ============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  body    String? @db.Text
  href    String?
  kind    String  @default("info")
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Values the Company Profile and Legal Pack mark "To Be Updated" live here, not
/// in code, so they can be corrected without a deploy.
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
