  @@map("posts")
}

/// No real testimonial exists yet — four documents require social proof but no
/// student quote, name or placement outcome is recorded anywhere. Modelled so the
/// Days 61-90 beta can harvest them; the section does not render while empty.
model Testimonial {
  id         String  @id @default(cuid())
  authorName String
  authorRole String?
  quote      String  @db.Text
  avatarUrl  String?
  /// Explicit publish consent — we are quoting a named real person.
  consentGivenAt DateTime?
  isPublished Boolean @default(false)
  ordinal     Int     @default(0)

  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Event {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  kind         EventKind
  description  String?   @db.Text
  coverImageUrl String?
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  isOnline     Boolean   @default(true)
  capacity     Int?
  isPublished  Boolean   @default(false)

  registrations EventRegistration[]

  createdAt DateTime @default(now())

  @@map("events")
}

enum EventKind {
  WEBINAR
  BOOTCAMP
  HACKATHON
  INNOVATION_CHALLENGE
  COMPETITION
  MASTERCLASS
}

model EventRegistration {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  email   String
  phone   String?

  createdAt DateTime @default(now())

  @@unique([eventId, email])
  @@map("event_registrations")
}

/// HR Framework §4 — careers pipeline. Not in the PRD's 11 modules at all.
model JobOpening {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  tasks        String[]
  requirements String[]
  benefits     String[]
  reportingTo  String?
  isOpen       Boolean  @default(true)

  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_openings")
}

model JobApplication {
  id        String     @id @default(cuid())
  openingId String
  opening   JobOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  name      String
  email     String
  phone     String?
  resumeUrl String?
  coverNote String? @db.Text
  stage     HiringStage @default(SCREENING)

  retentionClass     RetentionClass @default(YEARS_5)
  retentionExpiresAt DateTime?
  purgedAt           DateTime?

