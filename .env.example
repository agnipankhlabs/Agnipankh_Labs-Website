# ---------------------------------------------------------------------------
# Agnipankh Labs — environment template
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Read by prisma.config.ts (for Migrate/Studio) and by lib/db.ts (pg adapter).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agnipankh?schema=public"

# --- Site ------------------------------------------------------------------
# Drives metadataBase, canonical URLs, and the QR payload baked into every
# certificate. Must be the real production origin before the first certificate
# is issued — the QR is permanent and cannot be reissued cleanly.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
# Must be a verified domain in Resend. Brand Kit §12 defines these addresses.
EMAIL_FROM="Agnipankh Labs <info@agnipankhlabs.com>"
# Where contact/partnership/careers form submissions are delivered.
EMAIL_TO_CONTACT="info@agnipankhlabs.com"
EMAIL_TO_PARTNERSHIPS="partnerships@agnipankhlabs.com"
EMAIL_TO_CAREERS="careers@agnipankhlabs.com"

# --- Rate limiting (Upstash Redis) -----------------------------------------
# Required in production: the Cybersecurity Framework mandates rate limiting on
# every public form. Absent locally, limiting fails open with a console warning.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Media (Cloudinary) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Certificate signing ---------------------------------------------------
# Server-side pepper mixed into the certificate SHA-256 hash so a leaked database
# alone does not let an attacker forge a passing verification.
# FROZEN AT FIRST ISSUANCE: rotating this invalidates every certificate already
# issued. Generate once with: openssl rand -hex 32
CERTIFICATE_HASH_SECRET=""
